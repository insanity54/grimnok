{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run devbox services",
      "type": "shell",
      "command": "devbox services up",
      "problemMatcher": [],
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    },
    {
      "label": "Migrate nakama",
      "type": "shell",
      "command": "nakama migrate up --config ./.config/nakama.yml",
      "problemMatcher": [],
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}/packages/server"
      }
    },
    {
      "label": "Run nakama (auto reload when source changes)",
      "type": "shell",
      "command": "find . -name '*.ts' | entr -r -s 'tsc && nakama --config ./.config/nakama.yml'",
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}/packages/server"
      },
      "runOptions": { 
      
        "runOn": "folderOpen"
      }
    },
    {
      "label": "Run bun dev",
      "type": "shell",
      "command": "bun run dev",
      "problemMatcher": [],
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}/packages/app"
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}