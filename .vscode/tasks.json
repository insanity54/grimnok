{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run tests",
      "type": "shell",
      "command": "bash -x test.sh",
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}/packages/app"
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "problemMatcher": []
    },
    {
      "label": "Run postgres",
      "type": "shell",
      "command": "postgres -k $PGHOST",
      "problemMatcher": [],
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    },
    {
      "label": "Migrate nakama",
      "type": "shell",
      "command": "nakama migrate up --config ./.config/nakama.yml",
      "problemMatcher": [],
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}/packages/server"
      }
    },
        {
      "label": "drizzle studio",
      "type": "shell",
      "command": "bun run db:studio",
      "problemMatcher": [],
      "isBackground": false,
      "options": {
        "cwd": "${workspaceFolder}/packages/server"
      }
    },
    {
      "label": "Run nakama",
      "type": "shell",
      "command": "find . -name '*.ts' | entr -r sh -c 'killall nakama; tsc && sleep 1; nakama --config ./.config/nakama.yml --runtime.env ORIGIN=$ORIGIN --runtime.env IPC_SECRET=$IPC_SECRET'",
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}/packages/server"
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "problemMatcher": []
    },
    {
      "label": "Run bun dev",
      "type": "shell",
      "command": "bun run dev",
      "problemMatcher": [],
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}/packages/app"
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}