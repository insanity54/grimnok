{
	"name": "grimnak",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --host",
		"build": "bun run build.ts",
		"build:modules": "cd src-nakama-modules && tsc",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio"
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.1",
		"@eslint/js": "^9.39.2",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/kit": "^2.49.3",
		"@sveltejs/vite-plugin-svelte": "^6.2.2",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.0.16",
		"bun-plugin-svelte": "^0.0.6",
		"drizzle-kit": "^0.31.8",
		"drizzle-orm": "^0.45.0",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.13.1",
		"globals": "^16.5.0",
		"phaser-navmesh": "^2.3.1",
		"playwright": "^1.57.0",
		"prettier": "^3.7.4",
		"prettier-plugin-svelte": "^3.4.1",
		"svelte": "^5.46.1",
		"svelte-check": "^4.3.5",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.52.0",
		"vite": "^7.3.1",
		"vitest": "^4.0.16",
		"vitest-browser-svelte": "^2.0.1"
	},
	"dependencies": {
		"@heroiclabs/nakama-js": "^2.8.0",
		"@types/bun": "^1.3.5",
		"@types/pg": "^8.16.0",
		"drizzle-kit": "^0.31.8",
		"drizzle-orm": "^0.45.1",
		"esm-env": "^1.2.2",
		"nakama-runtime": "https://github.com/heroiclabs/nakama-common",
		"nostr-login": "^1.7.12",
		"nostr-tools": "^2.19.4",
		"pg": "^8.16.3",
		"phaser": "^3.90.0",
		"postgres": "^3.4.7",
		"svelte-adapter-bun": "^1.0.1",
		"svelte-identicons": "^1.0.4",
		"uuid": "^13.0.0",
		"window.nostr.js": "^0.5.0"
	}
}
